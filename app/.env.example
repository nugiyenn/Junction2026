# Copy to .env.local, and set the same names in Vercel (Project > Settings > Environment Variables).

# Needed for the full demo
AIVEN_DATABASE_URL=
GEMINI_API_KEY=
FEATHERLESS_API_KEY=
VALIO_API_KEY=
OXYLABS_WEB_API_KEY=

# Optional: Nemotron reads long product pages and picks matches
NVIDIA_API_KEY=

# Optional: Aiven Valkey (Valio cache, rate limits, idempotent orders). Unset = those are off.
AIVEN_VALKEY_URL=

# Optional: Aiven Kafka (decision events). Unset = no events. The CA is Aiven's certificate, base64 or one line with literal \n.
AIVEN_KAFKA_BROKERS=
AIVEN_KAFKA_USERNAME=
AIVEN_KAFKA_PASSWORD=
AIVEN_KAFKA_CA=

# Optional: Aiven ClickHouse over HTTPS (https://user:password@host:port). Unset = stats come from Postgres.
AIVEN_CLICKHOUSE_URL=

# Approving an order or editing a mandate needs this key (Authorization: Bearer ...). Empty = those routes are open.
APPROVER_KEY=

# Allow POST /api/demo/reset when deployed (wipes quotes, orders, audit). Leave unset in real use.
ALLOW_DEMO_RESET=

# Rarely needed, all have defaults: LLM_PRIMARY=featherless, NEMOTRON_MODEL, AIVEN_CLICKHOUSE_DATABASE,
# AIVEN_KAFKA_SASL_MECHANISM, RATE_LIMIT_{REQUESTS,QUOTES,ORDERS,RECIPE,VERIFY}_PER_MIN.
