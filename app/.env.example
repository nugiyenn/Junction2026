# Copy to .env.local (local) and set the same names in Vercel → Project → Settings → Environment Variables.
AIVEN_DATABASE_URL=
# Aiven for Valkey (rediss://...). Optional: without it, the Valio cache, per-agent rate limits and idempotent orders are off.
AIVEN_VALKEY_URL=
GEMINI_API_KEY=
GROQ_API_KEY=
FEATHERLESS_API_KEY=
OXYLABS_WEB_API_KEY=
VALIO_API_KEY=
# Aiven for Apache Kafka (decision events, topic trade-events). Brokers as host:port. CA = Aiven's CA certificate as base64 or one line with literal \n.
# SASL mechanism: scram-sha-256 (default), scram-sha-512 or plain. Unset = events are not published.
AIVEN_KAFKA_BROKERS=
AIVEN_KAFKA_USERNAME=
AIVEN_KAFKA_PASSWORD=
AIVEN_KAFKA_CA=
AIVEN_KAFKA_SASL_MECHANISM=
# Aiven for ClickHouse over HTTPS: https://user:password@host:port. Unset = stats come from Postgres.
AIVEN_CLICKHOUSE_URL=
# Optional: ClickHouse database holding orders_fact and trade_events (default: default).
AIVEN_CLICKHOUSE_DATABASE=
# Nemotron (build.nvidia.com). Optional: with the key set, page extraction tries Nemotron first. NEMOTRON_MODEL overrides the
# default id nvidia/nemotron-3.5-super-vl-120b-a12b (inferred from the model's page URL: confirm it against the page's sample code).
NVIDIA_API_KEY=
NEMOTRON_MODEL=
# Allow POST /api/demo/reset (wipes quotes, orders, audit) when deployed. Leave unset in real use.
ALLOW_DEMO_RESET=
# Set to "featherless" while building, to try Featherless (fast) before Gemma. Leave empty for Gemma first (the default, and for the demo).
LLM_PRIMARY=
# Optional per-mandate rate limits (calls per minute). Defaults leave room for several demo visitors.
RATE_LIMIT_REQUESTS_PER_MIN=
RATE_LIMIT_QUOTES_PER_MIN=
RATE_LIMIT_ORDERS_PER_MIN=
RATE_LIMIT_VERIFY_PER_MIN=
RATE_LIMIT_REDTEAM_PER_MIN=
# Approving an order or editing a mandate needs this key (Authorization: Bearer ...). Leave empty to keep those routes open.
APPROVER_KEY=
