# Copy to .env.local (local) and set the same names in Vercel → Project → Settings → Environment Variables.
AIVEN_DATABASE_URL=
# Aiven for Valkey (rediss://...). Optional: without it, the Valio cache, per-agent rate limits and idempotent orders are off.
AIVEN_VALKEY_URL=
GEMINI_API_KEY=
GROQ_API_KEY=
FEATHERLESS_API_KEY=
OXYLABS_WEB_API_KEY=
VALIO_API_KEY=
# Allow POST /api/demo/reset (wipes quotes, orders, audit) when deployed. Leave unset in real use.
ALLOW_DEMO_RESET=
# Set to "featherless" while building, to try Featherless (fast) before Gemma. Leave empty for Gemma first (the default, and for the demo).
LLM_PRIMARY=
