# Copy to .env.local (local) and set the same names in Vercel → Project → Settings → Environment Variables.
AIVEN_DATABASE_URL=
GEMINI_API_KEY=
GROQ_API_KEY=
FEATHERLESS_API_KEY=
OXYLABS_WEB_API_KEY=
VALIO_API_KEY=
# Nemotron (build.nvidia.com). Optional: with the key set, page extraction tries Nemotron first. NEMOTRON_MODEL overrides the
# default id nvidia/nemotron-3.5-super-vl-120b-a12b (inferred from the model's page URL: confirm it against the page's sample code).
NVIDIA_API_KEY=
NEMOTRON_MODEL=
# Allow POST /api/demo/reset (wipes quotes, orders, audit) when deployed. Leave unset in real use.
ALLOW_DEMO_RESET=
# Set to "featherless" while building, to try Featherless (fast) before Gemma. Leave empty for Gemma first (the default, and for the demo).
LLM_PRIMARY=
